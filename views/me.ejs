<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <%- include('section/head') %>
    <title>個人檔案 - Wu Jo</title>
    <style>
        /* ==========================================
           全純 CSS 控制，完全不依賴任何 Tailwind
           ========================================== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: #FAFAFA !important; /* 全面改為 Wu Jo 清爽白底 */
            color: #333333 !important;
            padding-bottom: 120px;
        }

        .main-container {
            max-width: 480px;
            margin: 0 auto;
            padding: 80px 20px 20px 20px;
        }

        /* 個人資訊區塊 */
        .profile-section {
            text-align: center;
            padding: 24px 0;
        }

        .avatar-wrapper {
            position: relative;
            display: inline-block;
            margin-bottom: 20px;
        }

        .avatar-border {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            padding: 4px;
            /* 換上 Wu Jo 焦糖金棕漸層环 */
            background: linear-gradient(135deg, #B37A48 0%, #823A00 100%);
            box-shadow: 0 8px 24px rgba(130, 58, 0, 0.15);
            overflow: hidden;
        }

        #userAvatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #FFFFFF; 
            background-color: #FAFAFA;
            transition: transform 0.3s ease;
        }

        #userAvatar.scaling {
            transform: scale(0.8);
        }

        /* 更換頭貼小按鈕 */
        #changeAvatarBtn {
            position: absolute;
            bottom: 2px;
            right: 2px;
            background-color: #823A00;
            border: 2px solid #FFFFFF;
            border-radius: 50%;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            transition: transform 0.1s;
        }
        #changeAvatarBtn:active { transform: scale(0.9); }
        #changeAvatarBtn svg { width: 14px; height: 14px; stroke: currentColor; }

        .user-name {
            font-size: 24px;
            font-weight: 900;
            color: #111111;
            margin-bottom: 6px;
        }

        .user-bio {
            font-size: 13px;
            color: #888888;
            font-style: italic;
        }

        /* 舞風標籤 */
        .tag-container {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 16px;
        }

        .dance-tag {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            padding: 4px 12px;
            border-radius: 20px;
            background-color: #F5EFEA;
            color: #B37A48;
            border: 1px solid rgba(179, 122, 72, 0.15);
        }

        /* 數據列 */
        .stats-container {
            display: flex;
            justify-content: center;
            gap: 48px;
            margin-top: 28px;
            background: #FFFFFF;
            padding: 16px;
            border-radius: 20px;
            border: 1px solid #EFEFEF;
        }

        .stat-box { text-align: center; }
        .stat-num { display: block; font-size: 20px; font-weight: 900; color: #823A00; }
        .stat-label { font-size: 11px; color: #888888; letter-spacing: 1px; margin-top: 2px; }

        /* 卡片共用樣式 */
        .section-title-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 32px 0 12px 0;
        }
        .section-title { font-size: 16px; font-weight: 800; color: #333333; }
        .section-badge { font-size: 10px; font-weight: 700; color: #B37A48; background: #F5EFEA; padding: 4px 8px; border-radius: 8px; }

        .info-card {
            background-color: #FFFFFF;
            border-radius: 24px;
            padding: 24px;
            border: 1px solid #EFEFEF;
            box-shadow: 0 6px 20px rgba(0,0,0,0.02);
        }

        /* 信用安全報告排版 */
        .report-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }
        .report-title-sub { font-size: 11px; color: #888888; letter-spacing: 1px; margin-bottom: 4px; }
        .report-score-box { display: flex; align-items: baseline; gap: 2px; }
        
        /* 🎨 優化：新增分數文字的顏色控制 class，徹底解決 VS Code 報錯 */
        .report-score-num { font-size: 40px; font-weight: 900; color: #333333; }
        .report-score-num.score-warn { color: #EF6C00; }
        
        .report-score-unit { font-size: 13px; color: #888888; }

        /* 狀態標籤顏色的純 CSS 樣式 */
        .status-badge { font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 20px; border: 1px solid transparent; }
        .status-good { color: #2E7D32; background: #E8F5E9; border-color: rgba(46,125,50,0.1); }
        .status-warn { color: #EF6C00; background: #FFF3E0; border-color: rgba(239,108,0,0.1); animation: pulse 2s infinite; }
        .status-danger { color: #C62828; background: #FFEBEE; border-color: rgba(198,40,40,0.1); }

        /* 進度條 */
        .progress-track { width: 100%; height: 10px; background-color: #F5F5F5; border-radius: 10px; overflow: hidden; margin-bottom: 16px; border: 1px solid #EFEFEF; }
        .progress-bar { height: 10px; transition: width 0.6s ease; }
        .bar-green { background-color: #4CAF50; }
        .bar-yellow { background-color: #FFB300; }
        .bar-red { background-color: #E53935; }

        /* 違規明細提示盒 */
        .alert-box { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-radius: 16px; font-size: 13px; border: 1px solid transparent; }
        .alert-box-warn { background-color: #FFFDE7; border-color: #FFF59D; color: #F57F17; font-weight: 600; }
        .alert-box-danger { background-color: #FFEBEE; border-color: #FFCDD2; color: #C62828; }
        .alert-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 8px; }
        .dot-yellow { background-color: #FFB300; }
        .dot-red { background-color: #E53935; }
        .alert-date { font-size: 11px; color: #888888; }
        
        .warning-text { font-size: 12px; font-weight: 700; margin-top: 10px; }
        .text-color-warn { color: #E65100; }
        .text-color-normal { color: #777777; font-style: italic; }

        .notice-text { font-size: 11px; color: #A0A0A0; margin-top: 16px; line-height: 1.5; }

        /* 近期預約卡片排版 */
        .booking-item { display: flex; align-items: center; gap: 16px; }
        .booking-date-block {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            /* 換上 Wu Jo 品牌專屬漸層 */
            background: linear-gradient(135deg, #B37A48 0%, #823A00 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
        }
        .booking-month { font-size: 10px; font-weight: 700; text-transform: uppercase; opacity: 0.9; }
        .booking-day { font-size: 18px; font-weight: 900; }
        .booking-details h4 { font-size: 14px; font-weight: 700; color: #333333; }
        .booking-details p { font-size: 12px; color: #888888; margin-top: 2px; }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.6; }
            100% { opacity: 1; }
        }
    </style>
</head>
<body>

    <%- include('section/nav') %>

    <main class="main-container">
        
        <section class="profile-section">
            <div class="avatar-wrapper">
                <div class="avatar-border">
                    <img id="userAvatar" alt="User Avatar" 
                         src="https://api.dicebear.com/7.x/avataaars/svg?seed=<%= user.name %>" />
                </div>
                <button id="changeAvatarBtn" title="隨機更換頭貼">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                </button>
            </div>
            
            <h2 class="user-name"><%= user.name %></h2>
            <p class="user-bio">" 能力越小，責任越小 "</p>
            
            <div class="tag-container">
                <span class="dance-tag">popping</span>
                <span class="dance-tag">House</span>
            </div>

            <div class="stats-container">
                <div class="stat-box">
                    <span class="stat-num">12</span>
                    <span class="stat-label">次預約</span>
                </div>
                <div class="stat-box">
                    <span class="stat-num">4.8</span>
                    <span class="stat-label">評分</span>
                </div>
                <div class="stat-box">
                    <span class="stat-num">15</span>
                    <span class="stat-label">貼文</span>
                </div>
            </div>
        </section>

        <section>
            <div class="section-title-box">
                <h3 class="section-title">信用安全報告</h3>
                <span class="section-badge">系統自動監控中</span>
            </div>

            <div class="info-card">
                <% 
                    // 後端計算檢舉狀態與對應顏色樣式
                    let reportCount = (locals.user && user.reports) ? user.reports : 0;
                    let barClass = "bar-green"; 
                    let statusClass = "status-good";
                    let statusText = "優良";

                    if (reportCount == 4) {
                        barClass = "bar-yellow";
                        statusClass = "status-warn";
                        statusText = "異常警告";
                    } else if (reportCount >= 5) {
                        barClass = "bar-red";
                        statusClass = "status-danger";
                        statusText = "已停權";
                    }
                    
                    let progressWidth = Math.min((reportCount / 5) * 100, 100) + '%';
                %>

                <div class="report-header">
                    <div>
                        <p class="report-title-sub">目前檢舉紀錄</p>
                        <div class="report-score-box">
                            <span class="report-score-num <%= reportCount == 4 ? 'score-warn' : '' %>">
                                <%= reportCount %>
                            </span>
                            <span class="report-score-unit">次</span>
                        </div>
                    </div>

                    <div>
                        <p class="report-title-sub" style="text-align: right;">帳號狀態</p>
                        <span class="status-badge <%= statusClass %>"><%= statusText %></span>
                    </div>
                </div>

                <div class="progress-track">
                    <div class="progress-bar <%= barClass %>" style="width: <%= progressWidth %>;"></div>
                </div>

                <div>
                    <% if (reportCount > 0) { %>
                        <div class="alert-box <%= reportCount >= 4 ? 'alert-box-warn' : 'alert-box-danger' %>">
                            <div style="display: flex; align-items: center;">
                                <div class="alert-dot <%= reportCount >= 4 ? 'dot-yellow' : 'dot-red' %>"></div>
                                <span>收到使用者檢舉：不當行為</span>
                            </div>
                            <span class="alert-date">2026-03-18</span>
                        </div>
                        
                        <p class="warning-text <%= reportCount == 4 ? 'text-color-warn' : 'text-color-normal' %>">
                            <% if (reportCount == 4) { %>
                                ⚠️ 嚴重警告：再收到 1 次檢舉將立即停權
                            <% } else { %>
                                ※ 系統偵測到您近期有 <%= reportCount %> 筆異常紀錄
                            <% } %>
                        </p>
                    <% } else { %>
                        <div class="alert-box" style="background-color: #FAFAFA; border-color: #EFEFEF; color: #777777;">
                            <span>本週無違規紀錄，繼續保持！</span>
                        </div>
                    <% } %>
                </div>

                <p class="notice-text">
                    * 提醒：累積檢舉達 5 次將限制功能。請保持良好禮節，維護 Wu Jo 環境。
                </p>
            </div>
        </section>

        <section style="margin-top: 32px;">
            <div class="section-title-box">
                <h3 class="section-title">近期預約</h3>
            </div>
            
            <div class="info-card booking-item">
                <div class="booking-date-block">
                    <span class="booking-month">Mar</span>
                    <span class="booking-day">24</span>
                </div>
                <div class="booking-details">
                    <h4>Studio • 18:30</h4>
                    <p>Kinetics Studio</p>
                </div>
            </div>
        </section>

    </main>

    <script>
        const avatarImg = document.getElementById('userAvatar');
        const changeBtn = document.getElementById('changeAvatarBtn');

        changeBtn.addEventListener('click', () => {
            const randomSeed = Math.random().toString(36).substring(7);
            avatarImg.classList.add('scaling');
            setTimeout(() => {
                avatarImg.src = `https://api.dicebear.com/7.x/avataaars/svg?seed=${randomSeed}`;
                avatarImg.onload = () => {
                    avatarImg.classList.remove('scaling');
                };
            }, 150);
        });
    </script>
</body>
</html>