<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <%- include('section/head') %>
    <title><%= typeof venue !== 'undefined' && venue.name ? venue.name : '教室詳情' %> - Wu Jo</title>
    <style>
        /* ==========================================
           教室詳情頁專屬純 CSS 樣式
           ========================================== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #FFFFFF !important;
            color: #000000 !important;
            padding-bottom: 120px;
        }

        .detail-container {
            max-width: 600px;
            margin: 0 auto;
            padding: 80px 16px 20px 16px;
        }

        /* 返回按鈕 */
        .btn-back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #B37A48 !important;
            text-decoration: none !important;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 20px;
            transition: opacity 0.2s;
        }

        .btn-back-link:hover {
            opacity: 0.8;
        }

        /* 詳情大卡片 */
        .detail-card {
            background: #FFFFFF;
            border: 1px solid #EFEFEF;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0,0,0,0.03);
        }

        /* 頂部主圖控制區，嚴格控制高度，絕對不暴走 */
        .detail-hero-box {
            width: 100%;
            height: 260px;
            background-color: #EFEFEF;
            overflow: hidden;
        }

        .detail-hero-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* 內容說明區 */
        .detail-main-body {
            padding: 24px;
        }

        .detail-title {
            font-size: 24px;
            font-weight: 900;
            color: #333333;
            margin-bottom: 8px;
        }

        .detail-price-tag {
            display: inline-block;
            font-size: 16px;
            color: #823A00; /* 焦糖棕色 */
            font-weight: 800;
            margin-bottom: 20px;
        }

        /* 分隔虛線 */
        .detail-divider {
            border: none;
            border-top: 1px dashed #EFEFEF;
            margin: 16px 0;
        }

        /* 設備與資訊欄位 */
        .info-section-title {
            font-size: 15px;
            font-weight: 800;
            color: #653600;
            margin-bottom: 10px;
        }

        .info-text {
            font-size: 14px;
            color: #555555;
            line-height: 1.6;
        }

        /* 底部預約大按鈕 */
        .btn-booking-submit {
            width: 100%;
            background-color: #823A00; 
            color: #FFFFFF !important;
            border: none;
            padding: 16px 0;
            border-radius: 16px;
            font-size: 16px;
            font-weight: 900;
            cursor: pointer;
            margin-top: 24px;
            box-shadow: 0 6px 20px rgba(130, 58, 0, 0.15);
            transition: background-color 0.2s, transform 0.1s;
        }

        .btn-booking-submit:hover {
            background-color: #653600;
        }

        .btn-booking-submit:active {
            transform: scale(0.98);
        }
        /* 預約表單 */
        .notice { font-size: 13px; line-height: 1.6; padding: 12px 16px; border-radius: 12px; margin-bottom: 16px; border: 1px solid transparent; }
        .notice-success { background: #E8F5E9; border-color: #C8E6C9; color: #2E7D32; }
        .notice-error { background: #FFEBEE; border-color: #FFCDD2; color: #C62828; }
        .book-field { display: flex; flex-direction: column; gap: 6px; margin-top: 14px; }
        .book-label { font-size: 13px; font-weight: 700; color: #555555; }
        .book-input { padding: 12px; border: 1px solid #DDDDDD; border-radius: 12px; font-size: 14px; background: #FFFFFF; }
        .hour-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 8px; }
        .hour-chip { text-align: center; padding: 8px 0; border-radius: 10px; font-size: 13px; font-weight: 700; background: #F5EFEA; color: #653600; }
        .hour-chip.taken { background: #F0F0F0; color: #AAAAAA; text-decoration: line-through; }
        .book-hint { font-size: 12px; color: #888888; margin-top: 8px; line-height: 1.6; }
        .btn-booking-submit:disabled { background: #CCCCCC; box-shadow: none; cursor: not-allowed; }
    </style>
</head>
<body>

    <%- include('section/nav') %>

    <main class="detail-container">
        
        <a href="/venues" class="btn-back-link">
            <span>←</span> 返回教室列表
        </a>

        <% if (typeof venue !== 'undefined' && venue) { %>
            
            <div class="detail-card">
                <div class="detail-hero-box">
                    <img src="<%= venue.image || '/img/venues1.jpg' %>" 
                         onerror="this.src='/img/venues1.jpg'; this.onerror=null;"
                         class="detail-hero-img" 
                         alt="<%= venue.name %>">
                </div>

                <div class="detail-main-body">
                    <h1 class="detail-title">📍 <%= venue.name %></h1>
                    <span class="detail-price-tag">$ <%= venue.price %> NTD / 小時</span>
                    
                    <hr class="detail-divider">
                    
                    <div class="info-section">
                        <h4 class="info-section-title">✨ 場地簡介與設備</h4>
                        <p class="info-text">
                            位於 <%= venue.dist || '市中心' %> 的專業舞蹈教室。空間寬敞、採光極佳，配備有全幅專業舞蹈落地鏡、環繞音響設備以及舒適的空調系統。適合街舞、MV舞蹈、現代舞練習或小型工作坊。
                        </p>
                    </div>

                    <hr class="detail-divider">

                    <div class="info-section">
                        <h4 class="info-section-title">🕒 預訂時段</h4>
                        <p class="info-text">每日 08:00 - 22:00（整點預約制），最多可預約未來 30 天，單次最長 <%= maxDuration %> 小時。</p>

                        <% if (locals.notice) { %>
                            <div class="notice notice-<%= notice.type %>" role="status" style="margin-top:12px;"><%= notice.text %></div>
                        <% } %>

                        <form action="/venues/<%= venue.id %>" method="GET">
                            <div class="book-field">
                                <label class="book-label" for="date">選擇日期</label>
                                <input type="date" id="date" name="date" class="book-input" value="<%= date %>" min="<%= minDate %>" max="<%= maxDate %>" onchange="this.form.submit()">
                            </div>
                        </form>

                        <p class="book-hint"><%= dateText %> 的時段（灰色為已被預約或已過）：</p>
                        <div class="hour-grid">
                            <% hours.forEach(function(h) { %>
                                <span class="hour-chip <%= h.available ? '' : 'taken' %>"><%= h.label %></span>
                            <% }); %>
                        </div>

                        <% if (locals.user) { %>
                            <% const freeHours = hours.filter(function(h) { return h.available; }); %>
                            <% if (freeHours.length > 0) { %>
                                <form action="/venues/<%= venue.id %>/book" method="POST">
                                    <input type="hidden" name="date" value="<%= date %>">
                                    <div class="book-field">
                                        <label class="book-label" for="startHour">開始時間</label>
                                        <select id="startHour" name="startHour" class="book-input" required>
                                            <% freeHours.forEach(function(h) { %>
                                                <option value="<%= h.hour %>"><%= h.label %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <div class="book-field">
                                        <label class="book-label" for="duration">使用時數</label>
                                        <select id="duration" name="duration" class="book-input" required>
                                            <% for (let d = 1; d <= maxDuration; d++) { %>
                                                <option value="<%= d %>"><%= d %> 小時（$ <%= venue.price * d %>）</option>
                                            <% } %>
                                        </select>
                                    </div>
                                    <button type="submit" class="btn-booking-submit">確認預訂</button>
                                    <p class="book-hint">開始前 2 小時內無法取消，請確定時間再送出。</p>
                                </form>
                            <% } else { %>
                                <p class="book-hint">這一天已經沒有可預約的時段，請換一天試試。</p>
                            <% } %>
                        <% } else { %>
                            <p class="book-hint">請先<a href="/login" style="color:#823A00;font-weight:700;">登入</a>才能預訂。</p>
                        <% } %>
                    </div>
                </div>
            </div>

        <% } else { %>
            <div style="text-align: center; padding: 60px 20px; color: #777;">
                <p style="font-size: 48px; margin-bottom: 16px;">🔍</p>
                <p style="font-size: 15px; font-weight: 700;">抱歉，找不到該教室的詳細資料。</p>
                <p style="font-size: 13px; color: #999; margin-top: 4px;">請確認網址 ID 是否正確，或返回列表重新嘗試。</p>
            </div>
        <% } %>

    </main>

</body>
</html>