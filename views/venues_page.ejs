<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <%- include('section/head') %>
    <title>找教室 - Wu Jo</title>
    <style>
        /* ==========================================
           找教室列表頁專屬純 CSS 樣式
           ========================================== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #FFFFFF !important; /* 大底色純白 */
            color: #000000 !important; /* 文字純黑 */
            padding-bottom: 120px; /* 留給底部導覽列空間 */
        }

        .venues-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 80px 16px 20px 16px; /* 避開頂部固定導覽列 */
        }

        /* 頁面標頭 */
        .page-header {
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 28px;
            font-weight: 900;
            color: #823A00; /* 焦糖棕主色 */
            letter-spacing: 1px;
        }

        /* 🚫 存取受限區塊 */
        .restricted-card {
            background-color: #FFF5F5;
            border: 1px solid #FFCDD2;
            border-radius: 28px;
            padding: 40px 24px;
            text-align: center;
            margin: 32px 0;
            box-shadow: 0 4px 15px rgba(211, 47, 47, 0.03);
        }

        .restricted-icon {
            font-size: 56px;
            margin-bottom: 16px;
        }

        .restricted-title {
            font-size: 22px;
            font-weight: 900;
            color: #D32F2F;
            margin-bottom: 12px;
        }

        .restricted-text {
            font-size: 14px;
            color: #555555;
            line-height: 1.6;
            margin-bottom: 24px;
        }

        .btn-row-center {
            display: flex;
            gap: 12px;
            justify-content: center;
        }

        .btn-check-credit {
            background-color: #FFFFFF;
            color: #B37A48 !important;
            border: 1px solid #DDDDDD;
            padding: 10px 20px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
        }

        .btn-submit-appeal {
            background-color: #D32F2F;
            color: #FFFFFF;
            border: none;
            padding: 10px 20px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

        /* 定位地圖模擬區塊 */
        .map-placeholder-box {
            margin-bottom: 24px;
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid #DDDDDD;
            height: 140px;
            position: relative;
            background-color: #EFEFEF;
        }

        .map-loading-text {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: #B37A48; 
            font-weight: 500;
        }

        .map-ping-dot {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .ping-wave {
            width: 14px;
            height: 14px;
            background-color: #CC8C53; 
            border-radius: 50%;
            position: absolute;
            animation: map-ping-animation 1.5s ease-out infinite;
        }

        .ping-center {
            width: 12px;
            height: 12px;
            background-color: #CC8C53;
            border-radius: 50%;
            border: 2px solid #FFFFFF;
            position: relative;
        }

        @keyframes map-ping-animation {
            0% { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(3); opacity: 0; }
        }

        /* 🧮 費用分攤計算器 */
        .calculator-card {
            background-color: #EFEFEF; 
            padding: 24px;
            border-radius: 28px;
            margin-bottom: 32px;
        }

        .calculator-title {
            font-size: 16px;
            font-weight: 900;
            color: #653600; 
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .calculator-inputs-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 16px;
        }

        .calc-input-field {
            width: 100%;
            background-color: #FFFFFF;
            border: 1px solid #DDDDDD;
            border-radius: 14px;
            padding: 12px 16px;
            font-size: 14px;
            outline: none;
        }

        .calc-result-panel {
            background-color: #FFFFFF;
            border: 1px solid #E0E0E0;
            border-radius: 16px;
            padding: 14px;
            text-align: center;
            margin-bottom: 16px;
        }

        .calc-result-label {
            font-size: 11px;
            color: #B37A48;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .calc-result-amount {
            font-size: 26px;
            font-weight: 900;
            color: #823A00; 
        }

        .btn-linepay-action {
            width: 100%;
            background-color: #06C755; 
            color: #FFFFFF;
            border: none;
            padding: 14px 0;
            border-radius: 14px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
        }

        .hidden {
            display: none !important;
        }

        /* 雙排網格佈局 */
        .venues-grid-layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }

        @media (min-width: 768px) {
            .venues-grid-layout {
                grid-template-columns: 1fr 1fr; /* 桌機呈現專業雙排 */
            }
        }
    </style>
</head>
<body>

    <%- include('section/nav') %>

    <main class="venues-container">
        
        <header class="page-header">
            <h1 class="page-title">找教室</h1>
        </header>

        <% let currentReports = (locals.user && user.reports) ? user.reports : 0; %>

        <% if (currentReports >= 5) { %>
            <div class="restricted-card">
                <div class="restricted-icon">🚫</div>
                <h3 class="restricted-title">存取受限</h3>
                <p class="restricted-text">
                    由於您的帳號被檢舉次數過高 (<%= currentReports %> 次)，<br>
                    為了維護社群安全，您的教室預訂功能已被暫時封鎖。
                </p>
                <div class="btn-row-center">
                    <a href="/me" class="btn-check-credit">查看信用狀態</a>
                    <button onclick="alert('申訴已受理，請等候 1-3 個工作天')" class="btn-submit-appeal">提交申訴</button>
                </div>
            </div>
        <% } else { %>
            
            <div class="map-placeholder-box">
                <div class="map-loading-text">📍 正在抓取您的位置...</div>
                <div class="map-ping-dot">
                    <div class="ping-wave"></div>
                    <div class="ping-center"></div>
                </div>
            </div>

            <div class="calculator-card">
                <h3 class="calculator-title"><span>🧮</span> Share - 費用分攤支付</h3>
                <div class="calculator-inputs-grid">
                    <input type="number" id="totalPrice" placeholder="場地總費 $" class="calc-input-field">
                    <input type="number" id="peopleCount" placeholder="分攤人數" class="calc-input-field">
                </div>
                <div class="calc-result-panel">
                    <p class="calc-result-label">每人應付</p>
                    <p class="calc-result-amount">$ <span id="result">0</span></p>
                </div>
                <div id="paySection" class="hidden">
                    <button onclick="alert('模擬支付成功！')" class="btn-linepay-action">使用 LINE Pay 支付</button>
                </div>
            </div>
            
            <div class="venues-grid-layout">
                <%- include('section/venues') %>
            </div>

        <% } %>
    </main>

    <script>
        const p = document.getElementById('totalPrice');
        const n = document.getElementById('peopleCount');
        const r = document.getElementById('result');
        const payBtn = document.getElementById('paySection');

        if(p && n) {
            function calculate() {
                const total = parseFloat(p.value) || 0;
                const people = parseInt(n.value) || 1;
                const share = Math.round(total / people);
                r.innerText = share;
                if (share > 0) payBtn.classList.remove('hidden');
                else payBtn.classList.add('hidden');
            }
            p.oninput = calculate;
            n.oninput = calculate;
        }
    </script>
</body>
</html>